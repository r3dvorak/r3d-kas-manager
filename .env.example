APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=300
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE_WORKSPACE=laravel_workspace_session
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# All-Inkl KAS API
KAS_WSDL=https://kasapi.kasserver.com/soap/wsdl/KasApi.wsdl
KAS_AUTH_WSDL=https://kasapi.kasserver.com/soap/wsdl/KasAuth.wsdl
KAS_USER=
KAS_PASSWORD=
KAS_AUTH_MODE=auto
# Optional: current Authy/TOTP code for session_2fa, set before running commands.
KAS_2FA_OTP=
KAS_SESSION_TOKEN=
KAS_SESSION_LIFETIME=1800
KAS_SESSION_UPDATE_LIFETIME=true
EXTERNAL_LAUNCH_TOKEN_TTL=60
KAS_WEBMAIL_BASE_URL=https://webmail.all-inkl.com/
KAS_PMA_URL_TEMPLATE=https://{login}.kasserver.com/mysqladmin/PMA5/index.php
EXTERNAL_LAUNCH_TOKEN_RETENTION_DAYS=7
EXTERNAL_LAUNCH_AUDIT_RETENTION_DAYS=30
IMPERSONATION_TOKEN_RETENTION_DAYS=7
